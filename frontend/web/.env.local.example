# Copy to .env.local once frontend/web is scaffolded (Next.js, ADR 0011).
# NEXT_PUBLIC_ prefix = Next.js bundles it into client code — fine here, a
# Firebase web API key is meant to be public (access is controlled by
# Firebase security rules, not by hiding this key).
#
# Firebase project: ai-voice-labs-473713 — reused from the prior project
# (voicica-ai) on purpose: its existing users carry over, since our `users`
# table bootstraps on first sight of any Firebase UID (ADR 0008).

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDk-NpGc31Bt0tOPlSYkZB-pYYyj6Nk1XY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-voice-labs-473713.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-voice-labs-473713
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-voice-labs-473713.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=304429736257
NEXT_PUBLIC_FIREBASE_APP_ID=1:304429736257:web:6920219bfefb37203341c0

# GA4 via Firebase Analytics (ADR 0021) — same Measurement ID as the prior
# project's Firebase project (reused on purpose, see CLAUDE.md). Only loaded
# on marketing-facing surfaces ((marketing), /get), never the authenticated
# app/admin. Leave unset to disable analytics entirely (e.g. local dev) —
# `lib/firebase.ts`'s getFirebaseAnalytics() no-ops without it, never throws.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-RWBX15PP30

# Backend API base URL for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Marketing site's own canonical origin (ADR 0019) — used for canonical/OG/
# hreflang URLs. No production domain is decided yet; set this once one is,
# don't leave it defaulting to localhost outside local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
