# Copy to .env.local once frontend/web is scaffolded (Next.js, ADR 0011).
# NEXT_PUBLIC_ prefix = Next.js bundles it into client code — fine here, a
# Firebase web API key is meant to be public (access is controlled by
# Firebase security rules, not by hiding this key) — but this file stays
# placeholder-only anyway, matching backend/.env.example's own convention:
# an "example" file's job is to show which keys exist, not to carry real
# values (a real, non-secret value here still isn't the point of this
# file, and just trips secret-scanning tools that don't know Firebase's
# specific model — happened once already, not repeating it).
#
# Firebase project: ai-voice-labs-473713 — reused from the prior project
# (voicica-ai) on purpose: its existing users carry over, since our `users`
# table bootstraps on first sight of any Firebase UID (ADR 0008). Get the
# real values from the Firebase Console (Project Settings → General →
# Your apps → SDK setup and configuration) — or, since this project's own
# values are genuinely public anyway, straight from the already-committed
# frontend/web/.env.production (ADR 0022), which the real deployed site
# actually reads.

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# GA4 via Firebase Analytics (ADR 0021) — leave unset to disable analytics
# entirely (e.g. local dev) — `lib/firebase.ts`'s getFirebaseAnalytics()
# no-ops without it, never throws. Only loaded on marketing-facing
# surfaces ((marketing), /get), never the authenticated app/admin.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend API base URL for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Marketing site's own canonical origin (ADR 0019) — used for canonical/OG/
# hreflang URLs. Real production value lives in .env.production; keep this
# defaulting to localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
