# Copy to .env and fill in. See app/core/config.py for how these are read.
# Business-tunable values (pricing rate, signup bonus) do NOT live here —
# they're in the app_settings DB table (ADR 0012), seeded by
# migrations/versions/..._seed_app_settings.py and editable via
# PATCH /admin/settings/{key}.

# Database (ADR 0006). Local dev: run Postgres via Docker, e.g.
#   docker run -d --name voicica-db -e POSTGRES_USER=voicica -e POSTGRES_PASSWORD=voicica -e POSTGRES_DB=voicica -p 5432:5432 postgres:16
DATABASE_URL=postgresql+asyncpg://voicica:voicica@localhost:5432/voicica
DATABASE_SSL_REQUIRE=false

# Using Neon instead: copy the connection string Neon gives you, but change
# `postgresql://` to `postgresql+asyncpg://` and DROP the `?sslmode=require&channel_binding=require`
# query params entirely (asyncpg doesn't understand them — see core/db.py) —
# then set DATABASE_SSL_REQUIRE=true instead, e.g.:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
#   DATABASE_SSL_REQUIRE=true

# Auth (ADR 0008) — a Firebase project's service account key. Either point at
# the downloaded JSON file, or paste its contents as one line of JSON.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Fish Audio (architecture.md §3e) — https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio

# Azure Speech — Azure Portal → your Speech resource → "Keys and Endpoint".
# Region matters: the API endpoint is https://{region}.tts.speech.microsoft.com/...
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud Text-to-Speech — an API key with that API enabled (Cloud Console
# → APIs & Services → Credentials). No service account needed for this one.
GOOGLE_TTS_API_KEY=

# Kie (ADR 0015) — wholesale model-catalog gateway. Get a key at
# https://kie.ai/api-key. PUBLIC_BASE_URL is optional — set it once this
# backend has a real public URL, so Kie can call back on completion; until
# then leave it blank and the poll-based cron sweep (worker/cron.py) is the
# only completion path (still correct, just up to ~1 minute slower).
# DIFFERS BY ENVIRONMENT (see backend/README.md's Deploy section) — blank
# locally, the real deployed URL (e.g. https://voicica-api.onrender.com) in
# production. Don't copy the local blank value over when deploying.
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
PUBLIC_BASE_URL=

# Redis (ADR 0014) — the arq task queue behind background job execution. Any
# real Redis works: a free-tier managed instance (Upstash, Redis Cloud) is
# the easiest path since this project has no local Docker/WSL to run one —
# same posture as Neon for Postgres. Include the password in the URL, e.g.
#   REDIS_URL=rediss://default:PASSWORD@some-host.upstash.io:6379
# (note `rediss://` — TLS — for most managed providers; plain `redis://` for
# a local, unauthenticated instance.)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (ADR 0004) — an R2 bucket + an API token scoped to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voicica-assets
# Required for Kie image-to-image (ADR 0016) — reference images need a real
# public URL Kie's servers can fetch. Simplest path: R2 bucket → Settings →
# Public Access → enable the "R2.dev subdomain" (no custom domain/DNS
# needed) → paste that pub-<hash>.r2.dev URL here. Leave blank and
# image-to-image models return 503 ("upload_unavailable") rather than
# silently generating a broken request.
R2_PUBLIC_BASE_URL=

# frontend/web's origin, for CORS.
# DIFFERS BY ENVIRONMENT (see backend/README.md's Deploy section) — this
# local-dev value silently blocks every real request once deployed if
# copied as-is (caught live on the first real deploy: "Disallowed CORS
# origin"). Production needs the real frontend domain(s) instead, e.g.
#   CORS_ALLOW_ORIGINS=["https://voicica.ai","https://www.voicica.ai"]
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
